{
  "name": "zoom-clone",
  "version": "1.0.0",
  "description": "Cross-platform video conferencing app (Electron + React + WebRTC)",
  "main": "dist/main/index.js",
  "author": "ZoomClone Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/karan211-Bruno/zoom-clone.git"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\" \"npm run dev:signaling\"",
    "dev:main": "tsx watch src/main/index.ts",
    "dev:renderer": "vite",
    "dev:signaling": "tsx watch src/signaling/server.ts",
    "build": "npm run build:main && npm run build:renderer && npm run build:signaling",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build:signaling": "tsc -p tsconfig.signaling.json",
    "start": "electron dist/main/index.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "uuid": "^10.0.0",
    "webrtc-adapter": "^9.0.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^32.3.3",
    "electron-builder": "^25.0.0",
    "oxlint": "^1.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.zoomclone.app",
    "productName": "ZoomClone",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json",
      "!node_modules/.cache/**/*",
      "!node_modules/.bin/**/*",
      "!node_modules/typescript/**/*",
      "!node_modules/tsx/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/@electron/rebuild/**/*"
    ],
    "asarUnpack": [
      "dist/signaling/**/*"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "public/icon.png"
    },
    "extraResources": [
      {
        "from": "dist/signaling",
        "to": "signaling",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
